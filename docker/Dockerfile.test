# Test image for the UI test suite (Playwright + chromium).
# Run via: npm run test:ui
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY server/package.json server/
COPY web/package.json web/
COPY pi-ext/package.json pi-ext/
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates curl python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

ENV VULCAIN_HOME=/tmp/vulcain-test
ENV VULCAIN_WORKSPACES=/tmp/vulcain-test/workspaces
ENV VULCAIN_CHAT_BACKEND=fake
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Playwright + chromium with its system deps (headless shell only is enough)
COPY test/ui/package.json test/ui/
COPY test/ui/package-lock.json* test/ui/
RUN cd test/ui && npm install --no-audit --no-fund
RUN cd test/ui && npx playwright install --with-deps chromium

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/web/dist ./web/dist
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/test ./test
COPY --from=build /app/package.json ./package.json

EXPOSE 7331

CMD ["node", "scripts/test-ui.mjs"]
