{
  "name": "vulcain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "pi-ext"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "concurrently -n server,web -c blue,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w pi-ext && npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test:ui": "node scripts/test-ui.mjs",
    "bench:typst-preview": "VULCAIN_HOME=/tmp/vulcain-typst-bench VULCAIN_PORT=7398 UI_SPEC=test/ui/bench-typst-preview.mjs node scripts/test-ui.mjs",
    "bench:idle-cpu": "VULCAIN_HOME=/tmp/vulcain-idle-cpu VULCAIN_PORT=7397 UI_SPEC=test/ui/bench-idle-cpu.mjs node scripts/test-ui.mjs",
    "test:websearch": "node test/web-search.mjs",
    "test:config": "node test/config.mjs",
    "test:ui:docker": "docker build -f docker/Dockerfile.test -t vulcain-test . && docker run --rm vulcain-test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
